{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend/"
    },
    "backend": {
      "root": "backend/"
    }
  },
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "backend"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "frontend"
    }
  ]
}
